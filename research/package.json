{
  "name": "@harmonia/research",
  "version": "1.0.0",
  "description": "Research experiments and analysis for Harmonia Causal Inference",
  "private": true,
  "scripts": {
    "figures:generate": "npx ts-node scripts/generate-manuscript-figures.ts",
    "data:download": "npx ts-node data/pipelines/data/download/synthea.ts",
    "data:download:1k": "npx ts-node data/pipelines/data/download/synthea.ts 1k",
    "data:download:100k": "npx ts-node data/pipelines/data/download/synthea.ts 100k",
    "data:download:2.8m": "npx ts-node data/pipelines/data/download/synthea.ts 2.3m",
    "data:download:mimic": "npx ts-node data/pipelines/data/download/mimic-demo.ts",
    "data:split:1k": "npx ts-node data/pipelines/data/split/split-omop-csv.ts --input data/raw/omop-data/synthea1k/ --output data/raw/splits/1k/ --num-sites 3 --scenario diabetes",
    "data:split:100k": "npx ts-node data/pipelines/data/split/split-omop-csv.ts --input data/raw/omop-data/synthea100k/ --output data/raw/splits/100k/ --num-sites 3 --scenario diabetes",
    "data:split:2.8m": "npx ts-node data/pipelines/data/split/split-omop-csv.ts --input data/raw/omop-data/synthea2.3m/ --output data/raw/splits/2.8m/ --num-sites 3 --scenario diabetes"
  },
  "dependencies": {
    "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.0.0",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^27.2.0",
    "katex": "^0.16.25",
    "marked": "^17.0.0",
    "plotly.js-dist-min": "^3.3.0",
    "puppeteer": "^24.30.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "causal-inference",
    "partial-identification",
    "manski-bounds",
    "omop-cdm",
    "federated-learning",
    "research"
  ],
  "author": "Daijiro Wachi",
  "license": "Apache-2.0"
}
