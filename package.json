{
  "name": "harmonia",
  "version": "0.1.0",
  "description": "Federated causal inference for privacy-preserving multi-site observational health data",
  "keywords": [
    "causal-inference",
    "federated-learning",
    "healthcare",
    "privacy-preserving",
    "partial-identification",
    "omop-cdm"
  ],
  "homepage": "https://github.com/watilde/Harmonia#readme",
  "bugs": {
    "url": "https://github.com/watilde/Harmonia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watilde/Harmonia.git"
  },
  "license": "Apache-2.0",
  "author": "Daijiro Wachi",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "test": "npm run test --workspaces --if-present",
    "test:validation": "jest tests/validation --testTimeout=1800000",
    "test:e2e": "jest tests/e2e --testTimeout=300000",
    "test:e2e:single": "jest tests/e2e/single-model.test.ts --testTimeout=300000",
    "test:e2e:federated": "jest tests/e2e/federated-learning.test.ts --testTimeout=300000",
    "test:e2e:pipeline": "jest tests/e2e/pipeline.test.ts --testTimeout=300000",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "polypharmacy:unit": "cd research/modules/5-billion-scale-polypharmacy && npx tsx src/test-omop-integration.ts",
    "polypharmacy:quick": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 1000 --tier 3 --output ./polypharmacy-results/quick",
    "polypharmacy:1m": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 3 --output ./polypharmacy-results/1m --verbose",
    "polypharmacy:10m": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 100 --patients 100000 --tier 3 --output ./polypharmacy-results/10m --verbose",
    "polypharmacy:100m": "cd research/modules/5-billion-scale-polypharmacy && node src/run100MOptimized.js",
    "polypharmacy:1b": "cd research/modules/5-billion-scale-polypharmacy && node src/run1BOptimized.js",
    "polypharmacy:tier1": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 1 --output ./polypharmacy-results/tier1",
    "polypharmacy:tier2": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 2 --output ./polypharmacy-results/tier2",
    "polypharmacy:tier3": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 3 --output ./polypharmacy-results/tier3",
    "polypharmacy:profile:us": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 3 --profile US --output ./polypharmacy-results/profile-us",
    "polypharmacy:profile:japan": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 3 --profile Japan --output ./polypharmacy-results/profile-japan",
    "polypharmacy:profile:nordic": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 3 --profile Nordic --output ./polypharmacy-results/profile-nordic",
    "polypharmacy:profile:india": "node packages/cli/dist/cli.js causal run-polypharmacy --sites 10 --patients 100000 --tier 3 --profile India --output ./polypharmacy-results/profile-india"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.24",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^30.2.0",
    "marked": "^17.0.1",
    "md-to-pdf": "^5.2.5",
    "prettier": "^3.1.0",
    "puppeteer": "^24.31.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node-gpu": "^4.22.0"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0"
  }
}
