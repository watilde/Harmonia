{
  "name": "@harmonia/core",
  "version": "0.1.0",
  "description": "Core federated learning algorithms and utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./causal": {
      "types": "./dist/causal/index.d.ts",
      "default": "./dist/causal/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "federated-learning",
    "machine-learning",
    "privacy-preserving"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  }
}
